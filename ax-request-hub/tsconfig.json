{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@ssam/ai-gateway": ["./packages/@ssam/ai-gateway/src/index"],
      "@ssam/scoring": ["./packages/@ssam/scoring/src/index"],
      "@ssam/gate-transitions": ["./packages/@ssam/gate-transitions/src/index"],
      "@ssam/notifications": ["./packages/@ssam/notifications/src/index"],
      "@ssam/agents": ["./packages/@ssam/agents/src/index"],
      "@ssam/agent-registry": ["./packages/@ssam/agent-registry/src/index"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "docs", "lib/*.disabled.ts", "prisma/seed-graph.ts"]
}
