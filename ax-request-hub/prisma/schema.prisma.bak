generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                   String      @id @default(cuid())
  title                String
  department           String
  requesterName        String
  requesterEmail       String
  source               String      @default("user_request")
  status               String      @default("submitted")
  description          String
  asIs                 String
  expectedBenefit      String
  confidentialityLevel String      @default("G2")
  championName         String?
  estimatedUsers       Int         @default(0)
  totalScore           Float?
  autoApproved         Boolean     @default(false)
  approvedBy           String?
  decisionNote         String?
  // Gate 2: Í∏∞Ïà† ?úÏ? Ï≤¥ÌÅ¨Î¶¨Ïä§??(ai-agent-standards Í∏∞Ï?)
  techHasApiSpec            Boolean @default(false)
  techHasDataClassification Boolean @default(false)
  techHasAuditLogging       Boolean @default(false)
  techHasTestCoverage       Boolean @default(false)
  techStandardsPassed       Boolean @default(false)
  techStandardsFailedItems  String  @default("[]")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // PI ?®Í≥º ?§ÌòÑ Ï∂îÏ†Å (v3.2)
  expectedBenefitValue Float?   // ?ïÎüâ ?àÏÉÅ ?®Í≥º (?∞Í∞Ñ ?òÏÇ∞)
  expectedBenefitUnit  String?  // "HOURS_YEAR" | "KRW_10K_YEAR"

  scoreCard      ScoreCard?
  chatSession    ChatSession?
  dataRequests   DataRequest[]
  agentRegistries AgentRegistry[]
  appeals         ProjectAppeal[]
  benefitRecords  BenefitRecord[]
}

model ScoreCard {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  impactScore          Float
  roiScore             Float
  confidentialityScore Float
  difficultyScore      Float
  readinessScore       Float
  strategyScore        Float
  totalScore           Float
  evaluationRationale  String
  evaluatedAt          DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(cuid())
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  messages    String
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

// ?Ä?Ä?Ä AI Hub ?†Í∑ú Î™®Îç∏ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

// Employee.role ?àÏö©Í∞?(P3-3a: EXECUTIVE, v3: DATA_PLATFORM Ï∂îÍ?)
// EMPLOYEE      ???ºÎ∞ò ÏßÅÏõê (Í∏∞Î≥∏Í∞?
// DEPT_HEAD     ??Î∂Ä?úÏû•: Î∂Ä??AI ?ÑÍµ¨ Î∞∞Î∂Ñ Í∂åÌïú
// AX_TEAM       ??AX?Ä(ADMIN): ?ÑÏ≤¥ Í¥ÄÎ¶?Í∂åÌïú
// C_LEVEL       ??C?àÎ≤® Í≤ΩÏòÅÏß? ?ÑÏ≤¥ Ï°∞Ìöå + ?πÏù∏ Í∂åÌïú
// EXECUTIVE     ???ÑÏõê: /executive ?Ä?úÎ≥¥???ÑÏö© ?ëÍ∑º (C_LEVEL ?òÏúÑ ÏßëÌï©)
// DATA_PLATFORM ???∞Ïù¥?∞Ìîå?´Ìèº?Ä: ?∞Ïù¥???êÏÇ∞ Í¥ÄÎ¶?Î∞??∞Ïù¥???îÏ≤≠ ?¨ÏÇ¨ Í∂åÌïú

model Employee {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  name           String
  email          String   @unique
  department     String
  jobTitle       String   @default("")
  role           String   @default("EMPLOYEE")
  currentLevel   String   @default("L0")
  levelGrantedAt DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  levelApplications    LevelApplication[]  @relation("ApplicantApplications")
  reviewedApplications LevelApplication[]  @relation("ReviewerApplications")
  levelHistories       LevelHistory[]      @relation("EmployeeHistory")
  grantedHistories     LevelHistory[]      @relation("GranterHistory")
  allocations          ServiceAllocation[] @relation("EmployeeAllocations")
  grantedAllocations   ServiceAllocation[] @relation("GranterAllocations")
  usageRecords         UsageRecord[]       @relation("EmployeeUsage")
  inputUsageRecords    UsageRecord[]       @relation("InputterUsage")
  usageAlerts          UsageAlert[]
  toolAccounts         ToolAccount[]
}

model DepartmentQuota {
  id          String        @id @default(cuid())
  department  String
  toolType    String        // "GPT_CHAT" | "GPT_EXCEL" | "GEMINI"
  totalQuota  Int           @default(0)
  aiDensity   String        @default("STANDARD") // "HIGH" | "MEDIUM" | "STANDARD"
  managedBy   String        // Î∂Ä?úÏû• ?¥Î©î??
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  toolAccounts ToolAccount[]

  @@unique([department, toolType])
}

model ToolAccount {
  id               String          @id @default(cuid())
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id])
  quotaId          String?
  quota            DepartmentQuota? @relation(fields: [quotaId], references: [id])
  toolType         String          // "GPT_CHAT" | "GPT_EXCEL" | "GEMINI"
  toolTier         String          // "CHAT" | "EXCEL" | "ENTERPRISE"
  status           String          @default("PENDING") // "PENDING" | "APPROVED" | "ACTIVE" | "SUSPENDED" | "RETURNED"
  requestReason    String          @default("")
  assignedByEmail  String?         // Î∞∞Ï†ï??Î∂Ä?úÏû• ?¥Î©î??
  approvedBy       String?
  approvedAt       DateTime?
  activatedAt      DateTime?
  lastUsedAt       DateTime?
  returnedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model LevelApplication {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation("ApplicantApplications", fields: [employeeId], references: [id])
  requestedLevel     String
  currentLevel       String    @default("L0")
  selfIntro          String    @default("")
  trainingCompleted  String    @default("")
  utilizationPlan    String    @default("")
  recommendationNote String    @default("")
  status             String    @default("PENDING")
  reviewNote         String    @default("")
  reviewedById       String?
  reviewedBy         Employee? @relation("ReviewerApplications", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LevelHistory {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation("EmployeeHistory", fields: [employeeId], references: [id])
  fromLevel   String
  toLevel     String
  reason      String   @default("")
  changedById String
  changedBy   Employee @relation("GranterHistory", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

model DistributionPolicy {
  id                 String              @id @default(cuid())
  level              String
  serviceName        String
  serviceDescription String              @default("")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  allocations        ServiceAllocation[]

  @@unique([level, serviceName])
}

model ServiceAllocation {
  id          String             @id @default(cuid())
  employeeId  String
  employee    Employee           @relation("EmployeeAllocations", fields: [employeeId], references: [id])
  policyId    String
  policy      DistributionPolicy @relation(fields: [policyId], references: [id])
  status      String             @default("ACTIVE")
  accountInfo String             @default("")
  grantedAt   DateTime           @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?
  grantedById String
  grantedBy   Employee           @relation("GranterAllocations", fields: [grantedById], references: [id])
  createdAt   DateTime           @default(now())
}

model TokenPolicy {
  id               String   @id @default(cuid())
  scope            String
  level            String?
  employeeId       String?
  service          String
  monthlyLimit     Int
  singleCallLimit  Int      @default(0)
  warningThreshold Int      @default(80)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UsageRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("EmployeeUsage", fields: [employeeId], references: [id])
  service    String
  yearMonth  String
  tokenUsed  Int      @default(0)
  costKrw    Float    @default(0)
  inputById  String
  inputBy    Employee @relation("InputterUsage", fields: [inputById], references: [id])
  createdAt  DateTime @default(now())

  @@unique([employeeId, service, yearMonth])
}

model UsageAlert {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  service      String
  yearMonth    String
  alertType    String
  acknowledged Boolean  @default(false)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ?Ä?Ä?Ä Module 8: ?êÍ∏∞ ?êÏù¥?ÑÌä∏ Í±∞Î≤Ñ?åÏä§ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

// Agent.status: ACTIVE | DEPRECATED | RETIRED
// Agent.deprecationReason: DUPLICATE | PERFORMANCE | POLICY_CHANGE | SCOPE_CHANGE | OTHER
// Agent.kpiType: ACCURACY | COMPLETION | TIME_SAVING | SATISFACTION
// Agent.kpiMeasureCycle: MONTHLY | QUARTERLY
// Agent.performanceFlag: null | WARNING | RETIRE_CANDIDATE
model Agent {
  id                  String    @id @default(cuid())
  name                String
  department          String
  description         String    @default("")
  status              String    @default("ACTIVE")
  deprecatedAt        DateTime?
  retiredAt           DateTime?
  deprecationReason   String?
  retirementNote      String?
  successorAgentId    String?
  dataRetentionYears  Int       @default(3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // KPI ?ïÏùò (?†Í∑ú)
  kpiName          String?
  kpiTarget        Float?
  kpiType          String?
  kpiMeasureMethod String?
  kpiMeasureCycle  String?   @default("MONTHLY")

  // ?±Í≥º Ï∂îÏ†Å (?†Í∑ú)
  lastUsedAt       DateTime?
  kpiMissCount     Int       @default(0)
  kpiLastScore     Float?
  performanceFlag  String?

  artifacts         AgentArtifact[]
  knowledgeExtracts AgentKnowledgeExtract[]
  kpiRecords        AgentKpiRecord[]
}

model AgentKpiRecord {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  recordMonth   String
  actualValue   Float
  targetValue   Float
  achieveRate   Float
  tokenCost     Float?
  performMatrix String?
  note          String?
  recordedBy    String
  createdAt     DateTime @default(now())
}

model AgentArtifact {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  artifactType  String
  title         String
  contentPath   String
  createdAt     DateTime @default(now())
  retainUntil   DateTime
  transferredTo String?
  archived      Boolean  @default(false)
}

model AgentKnowledgeExtract {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  promptPatterns String?
  failureCases   String?
  useCaseSummary String?
  lessonsLearned String?
  extractedBy    String
  extractedAt    DateTime @default(now())
}

// ?Ä?Ä?Ä AI Hub Î¶¨ÌÑ∞?¨Ïãú + Í±∞Î≤Ñ?åÏä§ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

model LiteracyCourse {
  id          String   @id @default(cuid())
  title       String
  level       String
  description String
  durationMin Int
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  enrollments LiteracyEnrollment[]
}

model LiteracyEnrollment {
  id          String    @id @default(cuid())
  employeeId  String
  courseId    String
  course      LiteracyCourse @relation(fields: [courseId], references: [id])
  status      String    @default("IN_PROGRESS")
  completedAt DateTime?
  score       Int?
  createdAt   DateTime  @default(now())
  @@unique([employeeId, courseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorEmail String
  detail     String   @default("")
  createdAt  DateTime @default(now())
}

model AgentRegistry {
  id                String       @id @default(cuid())
  agentName         String       @unique
  agentKey          String       @unique
  version           String       @default("1.0.0")
  purpose           String
  dataSource        String
  owner             String       @default("CTO")
  status            String       @default("active")
  realDataConnected Boolean      @default(false)
  fallbackRate      Float        @default(1.0)
  gate1Passed       Boolean      @default(false)
  gate2Passed       Boolean      @default(false)
  gate3Passed       Boolean      @default(false)
  lifecycleStage    String       @default("GATE1")
  gate1PassedAt     DateTime?
  gate2PassedAt     DateTime?
  gate3PassedAt     DateTime?
  operatorTrustScore Int?
  operatorComment   String?
  sam30dAccuracy    Float?
  degradedSince     DateTime?
  retiredAt         DateTime?
  retireReason      String?
  lastEvaluatedAt   DateTime?
  nextReviewAt      DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // v3 Ï∂îÍ? ?ÑÎìú: ?¥Ï§ë ?ºÏù¥?ÑÏÇ¨?¥ÌÅ¥ Î∞??∞Ïù¥???åÎû´???∞Îèô
  name           String?      // Agent.name Îß§Ïπ≠??(?¥Í? ???ÑÏàò)
  projectId      String?      // ?∞Í≥Ñ Project (?¥Í? ???ÑÏàò)
  phase          String       @default("DEVELOPMENT") // AgentPhase: DEVELOPMENT|PRODUCTION|CLOSED
  devStage       String?      // DevStage ??phase=DEVELOPMENT ?ÑÏö©
  prodStatus     String?      // ProdStatus ??phase=PRODUCTION ?ÑÏö©
  trustScore     Int?         // (operatorTrustScore Î≥ÑÏπ≠)
  pilotKpiTarget String?      // JSON 4?ÑÎìú ???ÑÌôò Í∑ºÍ±∞
  prodKpiTarget  String?      // JSON 4?ÑÎìú ???ëÏùò???πÏù∏ ???ïÏ†ï
  retireFlag     Boolean      @default(false)
  lastUsedAt     DateTime?
  productionAt   DateTime?    // ?ëÏùò???πÏù∏ ???ÅÏö© ?ÑÌôò ?ºÏãú

  scores        AgentScore[]
  projects      AgentProjectLink[]
  councilItems  CouncilAgendaItem[]
  project       Project?            @relation(fields: [projectId], references: [id])
}

// ?Ä?Ä?Ä ?ÑÎ°ú?ùÌä∏-?êÏù¥?ÑÌä∏ M:N Í¥ÄÎ¶??Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

model AXProject {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  domain      String
  description String   @default("")
  owner       String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents      AgentProjectLink[]
}

model AgentProjectLink {
  id        String        @id @default(cuid())
  agentId   String
  agent     AgentRegistry @relation(fields: [agentId], references: [id])
  projectId String
  project   AXProject     @relation(fields: [projectId], references: [id])
  role      String        @default("PRIMARY")
  addedAt   DateTime      @default(now())

  @@unique([agentId, projectId])
}

model AgentScore {
  id         String        @id @default(cuid())
  agentId    String
  agent      AgentRegistry @relation(fields: [agentId], references: [id])
  // Í∏∞Ï°¥ Gate ?âÍ? ?êÏàò ?ÑÎìú (ETF ?ÑÎ©î??
  ticker     String?
  score      Float?
  rationale  String?
  dataType   String        @default("mock")
  recordedAt DateTime      @default(now())
  // v3 Ï∂îÍ? ?ÑÎìú: KPI ?îÎ≥Ñ ?§Ï†Å (phase=DEVELOPMENT ???åÏùº??/ phase=PRODUCTION ???ÅÏö©)
  phase      String?       // AgentPhase: DEVELOPMENT|PRODUCTION|CLOSED
  month      String?       // "2026-07"
  kpiActual  String?       // JSON 4?ÑÎìú
  achieveRate Int?          // ?¨ÏÑ±Î•?%

  @@unique([agentId, phase, month])
}

// ?Ä?Ä AI ?§ÌÇ¨ Ïπ¥ÌÉàÎ°úÍ∑∏ (AX_?ÑÏÇ¨AI?¥ÏòÅÏ≤¥Í≥Ñ_?úÏïà ¬ß1) ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä
model Skill {
  id            String    @id @default(cuid())
  skillId       String    @unique   // e.g. "skill-etf-nav-check"
  name          String
  version       String    @default("1.0.0")
  category      String    // ?ÖÎ¨¥?êÎèô??| ETF?¥Ïö© | Î¶¨ÏÑúÏπ?| Î¨∏ÏÑú?ëÏÑ± | ?∞Ïù¥?∞Î∂Ñ??| Í∏∞Ì?
  author        String
  approvedBy    String    @default("")
  approvedAt    DateTime?
  status        String    @default("draft")   // active | draft | deprecated
  targetUsers   String    @default("[]")      // JSON array of roles
  securityLevel String    @default("G1")      // G1(?ºÎ∞ò) | G2(?¥Î?) | G3(Í∏∞Î?)
  purpose       String    @default("")
  instructions  String    @default("")
  promptText    String    @default("")
  examples      String    @default("")
  cautions      String    @default("")
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ratings       SkillRating[]
}

model SkillRating {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  employeeEmail String
  score     Int      // 1~5
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@unique([skillId, employeeEmail])
}

// ?Ä?Ä?Ä v3: SQLite??enum ÎØ∏Ï?????String ?ÑÎìú + ÏΩîÎìú ?àÎ≤® ?úÏïΩ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä
// DataClassification: G1(Í≥µÍ∞ú) | G2(?¥Î?) | G3(Í∏∞Î?)
// DataRequestType:    ACCESS(Í∏∞Ï°¥ ?êÏÇ∞ ?¥Ïö©) | NEW(?†Í∑ú ?òÏßë ?îÏ≤≠)
// DataRequestStatus:  REQUESTED | REVIEWING | SEC_REVIEW | APPROVED | COLLECTING | REJECTED | PROVISIONED | EXPIRED | REVOKED
// AgentPhase:         DEVELOPMENT | PRODUCTION | CLOSED
// DevStage:           SUBMITTED | EVALUATED | GATE1 | GATE2 | GATE3 | PILOT_PROVEN | COUNCIL_PENDING | COND_APPROVED | DEV_REJECTED
// ProdStatus:         ACTIVE | SUSPENDED | DEPRECATED | RETIRED
// CouncilDecision:    APPROVED | CONDITIONAL | REMANDED | REJECTED | DEFERRED

// ?Ä?Ä?Ä v3: ?ëÏùò??Î™®Îç∏ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

model CouncilMeeting {
  id        String              @id @default(cuid())
  meetingNo Int                 @unique
  heldAt    DateTime
  notes     String?
  items     CouncilAgendaItem[]
}

model CouncilAgendaItem {
  id           String         @id @default(cuid())
  meetingId    String
  meeting      CouncilMeeting @relation(fields: [meetingId], references: [id])
  agentId      String
  agent        AgentRegistry  @relation(fields: [agentId], references: [id])
  itemType     String         // PROD_APPROVAL | RETIRE_APPROVAL | MAJOR_CHANGE
  packageMeta  String         // ?¨Ïùò ?®ÌÇ§ÏßÄ ?§ÎÉÖ??(JSON)
  decision     String?        // CouncilDecision: APPROVED|CONDITIONAL|REMANDED|REJECTED|DEFERRED
  decisionNote String?
  conditions   String?        // JSON: [{condition, done, checkedBy}]
  decidedAt    DateTime?
}

// ?Ä?Ä?Ä v3: ?∞Ïù¥???åÎû´??Î™®Îç∏ ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä

model DataAsset {
  id             String    @id @default(cuid())
  name           String
  description    String
  ownerDept      String
  classification String    // DataClassification: G1|G2|G3
  schemaMeta     String?
  deliveryModes  String    // "API,FILE,DB"
  updateCycle    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  requests       DataRequest[]
}

model DataRequest {
  id             String    @id @default(cuid())
  type           String    // DataRequestType: ACCESS|NEW
  status         String    @default("REQUESTED") // DataRequestStatus
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  agentId        String?
  assetId        String?
  asset          DataAsset? @relation(fields: [assetId], references: [id])
  requesterId    String
  purpose        String
  requestedSpec  String?
  classification String    // DataClassification: G1|G2|G3
  periodMonths   Int
  forProduction  Boolean   @default(false)
  rejectReason   String?
  reviewerId     String?
  prevRequestId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  provision      DataProvision?
}

model DataProvision {
  id            String      @id @default(cuid())
  requestId     String      @unique
  request       DataRequest @relation(fields: [requestId], references: [id])
  deliveryMode  String      // API | FILE | DB
  connectionRef String      // ?úÌÅ¨Î¶??Ä?•ÏÜå ??
  providedAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
}

// ?Ä?Ä ?¥Ïùò?úÍ∏∞ (P1-3: ?†Ï≤≠???¨Ïã¨ ?îÏ≤≠ ?àÏ∞®) ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä
model ProjectAppeal {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  requesterEmail  String                         // ?†Ï≤≠???¥Î©î??
  reason          String                         // ?¥Ïùò ?¨Ïú†
  evidenceNote    String    @default("")         // Í∑ºÍ±∞ ?êÎ£å¬∑Î≥¥Ï∂© ?§Î™Ö
  status          String    @default("PENDING")  // PENDING | UNDER_REVIEW | ACCEPTED | REJECTED
  reviewedBy      String?                        // AX?Ä Í≤Ä?†Ïûê ?¥Î©î??
  reviewNote      String    @default("")         // AX?Ä Í≤Ä???òÍ≤¨
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ?Ä?Ä Í±∞Î≤Ñ?åÏä§ Î¨∏ÏÑú Î©îÌ??∞Ïù¥??(AX_?ÑÏÇ¨AI?¥ÏòÅÏ≤¥Í≥Ñ_?úÏïà ¬ß2) ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä
// docId Ï≤¥Í≥Ñ: AX-{TYPE}-{YYYY}-{NNN}
//   REG=Í∑úÏ†ï | OPS=?¥ÏòÅÎ∞©Ïïà | GUI=ÏßÄÏπ?| GDL=Í∞Ä?¥Îìú?ºÏù∏ | MAN=Îß§Îâ¥??| DEV=Í∞úÎ∞ú?úÏ? | TEC=Í∏∞Ïà†Î¨∏ÏÑú
model GovernanceDoc {
  id            String    @id @default(cuid())
  docId         String    @unique   // e.g. "AX-REG-2026-001"
  fileName      String    @unique   // docs/ ?òÏúÑ ?åÏùºÎ™?e.g. "AX-GUIDELINE-2026-001_AIÍ±∞Î≤Ñ?åÏä§Í∏∞Î≥∏ÏßÄÏπ?md"
  type          String    // Í∑úÏ†ï|?¥ÏòÅÎ∞©Ïïà|ÏßÄÏπ?Í∞Ä?¥Îìú?ºÏù∏|Îß§Îâ¥??Í∞úÎ∞ú?úÏ?|Í∏∞Ïà†Î¨∏ÏÑú
  level         String    @default("L2")  // L1|L2|L3|L4
  title         String
  version       String    @default("v1.0")
  author        String    @default("")
  approvedBy    String    @default("")
  approvedAt    DateTime?
  securityLevel String    @default("G2")  // G1|G2|G3
  status        String    @default("active")  // active|draft|deprecated
  description   String    @default("")
  relatedDocs   String    @default("[]")  // JSON: Í¥Ä??Î¨∏ÏÑú docId Î∞∞Ïó¥
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// v3.1 ???∏Ïï± ?åÎ¶º (Telegram ?ÄÏ≤?1?®Í≥Ñ)
model Notification {
  id             String    @id @default(cuid())
  recipientEmail String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientEmail, readAt])
}

// ?Ä?Ä?Ä PI ?®Í≥º ?§ÌòÑ Ï∂îÏ†Å (v3.2) ?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä?Ä
model BenefitRecord {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  agentId       String?
  period        String   // "2026-Q3"
  realizedValue Float
  unit          String
  note          String   @default("")
  recordedBy    String
  createdAt     DateTime @default(now())

  @@unique([projectId, period])
}


