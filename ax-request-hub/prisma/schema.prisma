generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                   String      @id @default(cuid())
  title                String
  department           String
  requesterName        String
  requesterEmail       String
  source               String      @default("user_request")
  status               String      @default("submitted")
  description          String
  asIs                 String
  expectedBenefit      String
  confidentialityLevel String      @default("G2")
  championName         String?
  estimatedUsers       Int         @default(0)
  totalScore           Float?
  autoApproved         Boolean     @default(false)
  approvedBy           String?
  decisionNote         String?
  // Gate 2: 기술 ?��? 체크리스??(ai-agent-standards 기�?)
  techHasApiSpec            Boolean @default(false)
  techHasDataClassification Boolean @default(false)
  techHasAuditLogging       Boolean @default(false)
  techHasTestCoverage       Boolean @default(false)
  techStandardsPassed       Boolean @default(false)
  techStandardsFailedItems  String  @default("[]")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // PI 효과 실현 추적 (v3.2)
  expectedBenefitValue Float?   // 정량 예상 효과 (연간 환산)
  expectedBenefitUnit  String?  // "HOURS_YEAR" | "KRW_10K_YEAR"

  // 데이터 거버넌스 정합성 (Phase 2 — 데이터취급지침 제5조)
  isEssentialBusiness  Boolean  @default(false)  // 본질적 업무 여부 (G3 데이터 사용 선결 조건)

  // Phase A — 과제 신청 시 데이터 요건 선언
  noDataRequired Boolean @default(false)  // true = "별도 데이터 불필요" 명시

  // 인테이크 채널 (v24)
  intakeMethod   String?  // "DIRECT" | "STANDARD_FORMAT" | "FILE" | "CHAT"
  aiConfidence   Float?   // Tier0=100, Tier1=0~80 (LLM 추출 신뢰도)
  agentType      String?  // "SKILL" | "MCP" | "WEBAPP" | "CRAWLING"
  scope          String?  // "DEPT" | "DIVISION" | "COMPANY"

  scoreCard      ScoreCard?
  chatSession    ChatSession?
  dataRequests   DataRequest[]
  agentRegistries AgentRegistry[]
  appeals         ProjectAppeal[]
  benefitRecords  BenefitRecord[]
}

model ScoreCard {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  impactScore          Float
  roiScore             Float
  confidentialityScore Float
  difficultyScore      Float
  readinessScore       Float
  strategyScore        Float
  totalScore           Float
  evaluationRationale  String
  evaluatedAt          DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(cuid())
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  messages    String
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

// ?�?�?� AI Hub ?�규 모델 ?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�

