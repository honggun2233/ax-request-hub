generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                   String      @id @default(cuid())
  title                String
  department           String
  requesterName        String
  requesterEmail       String
  source               String      @default("user_request")
  status               String      @default("submitted")
  description          String
  asIs                 String
  expectedBenefit      String
  confidentialityLevel String      @default("G2")
  championName         String?
  estimatedUsers       Int         @default(0)
  totalScore           Float?
  autoApproved         Boolean     @default(false)
  approvedBy           String?
  decisionNote         String?
  // Gate 2: 기술 표준 체크리스트 (ai-agent-standards 기준)
  techHasApiSpec            Boolean @default(false)
  techHasDataClassification Boolean @default(false)
  techHasAuditLogging       Boolean @default(false)
  techHasTestCoverage       Boolean @default(false)
  techStandardsPassed       Boolean @default(false)
  techStandardsFailedItems  String  @default("[]")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // PI 효과 실현 추적 (v3.2)
  expectedBenefitValue Float?   // 정량 예상 효과 (연간 환산)
  expectedBenefitUnit  String?  // "HOURS_YEAR" | "KRW_10K_YEAR"

  scoreCard      ScoreCard?
  chatSession    ChatSession?
  dataRequests   DataRequest[]
  agentRegistries AgentRegistry[]
  appeals         ProjectAppeal[]
  benefitRecords  BenefitRecord[]
}

model ScoreCard {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  impactScore          Float
  roiScore             Float
  confidentialityScore Float
  difficultyScore      Float
  readinessScore       Float
  strategyScore        Float
  totalScore           Float
  evaluationRationale  String
  evaluatedAt          DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(cuid())
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  messages    String
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

// ─── AI Hub 신규 모델 ─────────────────────────────

// Employee.role 허용값 (P3-3a: EXECUTIVE, v3: DATA_PLATFORM 추가)
// EMPLOYEE      — 일반 직원 (기본값)
// DEPT_HEAD     — 부서장: 부서 AI 도구 배분 권한
// AX_TEAM       — AX팀(ADMIN): 전체 관리 권한
// C_LEVEL       — C레벨 경영진: 전체 조회 + 승인 권한
// EXECUTIVE     — 임원: /executive 대시보드 전용 접근 (C_LEVEL 하위 집합)
// DATA_PLATFORM — 데이터플랫폼팀: 데이터 자산 관리 및 데이터 요청 심사 권한

model Employee {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  name           String
  email          String   @unique
  department     String
  jobTitle       String   @default("")
  role           String   @default("EMPLOYEE")
  currentLevel   String   @default("L0")
  levelGrantedAt DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  levelApplications    LevelApplication[]  @relation("ApplicantApplications")
  reviewedApplications LevelApplication[]  @relation("ReviewerApplications")
  levelHistories       LevelHistory[]      @relation("EmployeeHistory")
  grantedHistories     LevelHistory[]      @relation("GranterHistory")
  allocations          ServiceAllocation[] @relation("EmployeeAllocations")
  grantedAllocations   ServiceAllocation[] @relation("GranterAllocations")
  usageRecords         UsageRecord[]       @relation("EmployeeUsage")
  inputUsageRecords    UsageRecord[]       @relation("InputterUsage")
  usageAlerts          UsageAlert[]
  toolAccounts         ToolAccount[]
}

model DepartmentQuota {
  id          String        @id @default(cuid())
  department  String
  toolType    String        // "GPT_CHAT" | "GPT_EXCEL" | "GEMINI"
  totalQuota  Int           @default(0)
  aiDensity   String        @default("STANDARD") // "HIGH" | "MEDIUM" | "STANDARD"
  managedBy   String        // 부서장 이메일
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  toolAccounts ToolAccount[]

  @@unique([department, toolType])
}

model ToolAccount {
  id               String          @id @default(cuid())
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id])
  quotaId          String?
  quota            DepartmentQuota? @relation(fields: [quotaId], references: [id])
  toolType         String          // "GPT_CHAT" | "GPT_EXCEL" | "GEMINI"
  toolTier         String          // "CHAT" | "EXCEL" | "ENTERPRISE"
  status           String          @default("PENDING") // "PENDING" | "APPROVED" | "ACTIVE" | "SUSPENDED" | "RETURNED"
  requestReason    String          @default("")
  assignedByEmail  String?         // 배정한 부서장 이메일
  approvedBy       String?
  approvedAt       DateTime?
  activatedAt      DateTime?
  lastUsedAt       DateTime?
  returnedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model LevelApplication {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation("ApplicantApplications", fields: [employeeId], references: [id])
  requestedLevel     String
  currentLevel       String    @default("L0")
  selfIntro          String    @default("")
  trainingCompleted  String    @default("")
  utilizationPlan    String    @default("")
  recommendationNote String    @default("")
  status             String    @default("PENDING")
  reviewNote         String    @default("")
  reviewedById       String?
  reviewedBy         Employee? @relation("ReviewerApplications", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LevelHistory {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation("EmployeeHistory", fields: [employeeId], references: [id])
  fromLevel   String
  toLevel     String
  reason      String   @default("")
  changedById String
  changedBy   Employee @relation("GranterHistory", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

model DistributionPolicy {
  id                 String              @id @default(cuid())
  level              String
  serviceName        String
  serviceDescription String              @default("")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  allocations        ServiceAllocation[]

  @@unique([level, serviceName])
}

model ServiceAllocation {
  id          String             @id @default(cuid())
  employeeId  String
  employee    Employee           @relation("EmployeeAllocations", fields: [employeeId], references: [id])
  policyId    String
  policy      DistributionPolicy @relation(fields: [policyId], references: [id])
  status      String             @default("ACTIVE")
  accountInfo String             @default("")
  grantedAt   DateTime           @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?
  grantedById String
  grantedBy   Employee           @relation("GranterAllocations", fields: [grantedById], references: [id])
  createdAt   DateTime           @default(now())
}

model TokenPolicy {
  id               String   @id @default(cuid())
  scope            String
  level            String?
  employeeId       String?
  service          String
  monthlyLimit     Int
  singleCallLimit  Int      @default(0)
  warningThreshold Int      @default(80)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UsageRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("EmployeeUsage", fields: [employeeId], references: [id])
  service    String
  yearMonth  String
  tokenUsed  Int      @default(0)
  costKrw    Float    @default(0)
  inputById  String
  inputBy    Employee @relation("InputterUsage", fields: [inputById], references: [id])
  createdAt  DateTime @default(now())

  @@unique([employeeId, service, yearMonth])
}

model UsageAlert {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  service      String
  yearMonth    String
  alertType    String
  acknowledged Boolean  @default(false)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ─── Module 8: 폐기 에이전트 거버넌스 ─────────────────────────────

// Agent.status: ACTIVE | DEPRECATED | RETIRED
// Agent.deprecationReason: DUPLICATE | PERFORMANCE | POLICY_CHANGE | SCOPE_CHANGE | OTHER
// Agent.kpiType: ACCURACY | COMPLETION | TIME_SAVING | SATISFACTION
// Agent.kpiMeasureCycle: MONTHLY | QUARTERLY
// Agent.performanceFlag: null | WARNING | RETIRE_CANDIDATE
model Agent {
  id                  String    @id @default(cuid())
  name                String
  department          String
  description         String    @default("")
  status              String    @default("ACTIVE")
  deprecatedAt        DateTime?
  retiredAt           DateTime?
  deprecationReason   String?
  retirementNote      String?
  successorAgentId    String?
  dataRetentionYears  Int       @default(3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // KPI 정의 (신규)
  kpiName          String?
  kpiTarget        Float?
  kpiType          String?
  kpiMeasureMethod String?
  kpiMeasureCycle  String?   @default("MONTHLY")

  // 성과 추적 (신규)
  lastUsedAt       DateTime?
  kpiMissCount     Int       @default(0)
  kpiLastScore     Float?
  performanceFlag  String?

  artifacts         AgentArtifact[]
  knowledgeExtracts AgentKnowledgeExtract[]
  kpiRecords        AgentKpiRecord[]
}

model AgentKpiRecord {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  recordMonth   String
  actualValue   Float
  targetValue   Float
  achieveRate   Float
  tokenCost     Float?
  performMatrix String?
  note          String?
  recordedBy    String
  createdAt     DateTime @default(now())
}

model AgentArtifact {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  artifactType  String
  title         String
  contentPath   String
  createdAt     DateTime @default(now())
  retainUntil   DateTime
  transferredTo String?
  archived      Boolean  @default(false)
}

model AgentKnowledgeExtract {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  promptPatterns String?
  failureCases   String?
  useCaseSummary String?
  lessonsLearned String?
  extractedBy    String
  extractedAt    DateTime @default(now())
}

// ─── AI Hub 리터러시 + 거버넌스 ─────────────────────────────

model LiteracyCourse {
  id          String   @id @default(cuid())
  title       String
  level       String
  description String
  durationMin Int
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  enrollments LiteracyEnrollment[]
}

model LiteracyEnrollment {
  id          String    @id @default(cuid())
  employeeId  String
  courseId    String
  course      LiteracyCourse @relation(fields: [courseId], references: [id])
  status      String    @default("IN_PROGRESS")
  completedAt DateTime?
  score       Int?
  createdAt   DateTime  @default(now())
  @@unique([employeeId, courseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorEmail String
  detail     String   @default("")
  createdAt  DateTime @default(now())
}

model AgentRegistry {
  id                String       @id @default(cuid())
  agentName         String       @unique
  agentKey          String       @unique
  version           String       @default("1.0.0")
  purpose           String
  dataSource        String
  owner             String       @default("CTO")
  status            String       @default("active")
  realDataConnected Boolean      @default(false)
  fallbackRate      Float        @default(1.0)
  gate1Passed       Boolean      @default(false)
  gate2Passed       Boolean      @default(false)
  gate3Passed       Boolean      @default(false)
  lifecycleStage    String       @default("GATE1")
  gate1PassedAt     DateTime?
  gate2PassedAt     DateTime?
  gate3PassedAt     DateTime?
  operatorTrustScore Int?
  operatorComment   String?
  sam30dAccuracy    Float?
  degradedSince     DateTime?
  retiredAt         DateTime?
  retireReason      String?
  lastEvaluatedAt   DateTime?
  nextReviewAt      DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // v3 추가 필드: 이중 라이프사이클 및 데이터 플랫폼 연동
  name           String?      // Agent.name 매칭용 (이관 후 필수)
  projectId      String?      // 연계 Project (이관 후 필수)
  phase          String       @default("DEVELOPMENT") // AgentPhase: DEVELOPMENT|PRODUCTION|CLOSED
  devStage       String?      // DevStage — phase=DEVELOPMENT 전용
  prodStatus     String?      // ProdStatus — phase=PRODUCTION 전용
  trustScore     Int?         // (operatorTrustScore 별칭)
  pilotKpiTarget String?      // JSON 4필드 — 전환 근거
  prodKpiTarget  String?      // JSON 4필드 — 협의회 승인 시 확정
  retireFlag     Boolean      @default(false)
  lastUsedAt     DateTime?
  productionAt   DateTime?    // 협의회 승인 → 상용 전환 일시

  scores        AgentScore[]
  projects      AgentProjectLink[]
  councilItems  CouncilAgendaItem[]
  project       Project?            @relation(fields: [projectId], references: [id])
}

// ─── 프로젝트-에이전트 M:N 관리 ─────────────────────────────

model AXProject {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  domain      String
  description String   @default("")
  owner       String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents      AgentProjectLink[]
}

model AgentProjectLink {
  id        String        @id @default(cuid())
  agentId   String
  agent     AgentRegistry @relation(fields: [agentId], references: [id])
  projectId String
  project   AXProject     @relation(fields: [projectId], references: [id])
  role      String        @default("PRIMARY")
  addedAt   DateTime      @default(now())

  @@unique([agentId, projectId])
}

model AgentScore {
  id         String        @id @default(cuid())
  agentId    String
  agent      AgentRegistry @relation(fields: [agentId], references: [id])
  // 기존 Gate 평가 점수 필드 (ETF 도메인)
  ticker     String?
  score      Float?
  rationale  String?
  dataType   String        @default("mock")
  recordedAt DateTime      @default(now())
  // v3 추가 필드: KPI 월별 실적 (phase=DEVELOPMENT → 파일럿 / phase=PRODUCTION → 상용)
  phase      String?       // AgentPhase: DEVELOPMENT|PRODUCTION|CLOSED
  month      String?       // "2026-07"
  kpiActual  String?       // JSON 4필드
  achieveRate Int?          // 달성률 %

  @@unique([agentId, phase, month])
}

// ── AI 스킬 카탈로그 (AX_전사AI운영체계_제안 §1) ────────────────────────────
model Skill {
  id            String    @id @default(cuid())
  skillId       String    @unique   // e.g. "skill-etf-nav-check"
  name          String
  version       String    @default("1.0.0")
  category      String    // 업무자동화 | ETF운용 | 리서치 | 문서작성 | 데이터분석 | 기타
  author        String
  approvedBy    String    @default("")
  approvedAt    DateTime?
  status        String    @default("draft")   // active | draft | deprecated
  targetUsers   String    @default("[]")      // JSON array of roles
  securityLevel String    @default("G1")      // G1(일반) | G2(내부) | G3(기밀)
  purpose       String    @default("")
  instructions  String    @default("")
  promptText    String    @default("")
  examples      String    @default("")
  cautions      String    @default("")
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ratings       SkillRating[]
}

model SkillRating {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  employeeEmail String
  score     Int      // 1~5
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@unique([skillId, employeeEmail])
}

// ─── v3: SQLite는 enum 미지원 → String 필드 + 코드 레벨 제약 ──────────
// DataClassification: G1(공개) | G2(내부) | G3(기밀)
// DataRequestType:    ACCESS(기존 자산 이용) | NEW(신규 수집 요청)
// DataRequestStatus:  REQUESTED | REVIEWING | SEC_REVIEW | APPROVED | COLLECTING | REJECTED | PROVISIONED | EXPIRED | REVOKED
// AgentPhase:         DEVELOPMENT | PRODUCTION | CLOSED
// DevStage:           SUBMITTED | EVALUATED | GATE1 | GATE2 | GATE3 | PILOT_PROVEN | COUNCIL_PENDING | COND_APPROVED | DEV_REJECTED
// ProdStatus:         ACTIVE | SUSPENDED | DEPRECATED | RETIRED
// CouncilDecision:    APPROVED | CONDITIONAL | REMANDED | REJECTED | DEFERRED

// ─── v3: 협의회 모델 ─────────────────────────────────────────────────

model CouncilMeeting {
  id        String              @id @default(cuid())
  meetingNo Int                 @unique
  heldAt    DateTime
  notes     String?
  items     CouncilAgendaItem[]
}

model CouncilAgendaItem {
  id           String         @id @default(cuid())
  meetingId    String
  meeting      CouncilMeeting @relation(fields: [meetingId], references: [id])
  agentId      String
  agent        AgentRegistry  @relation(fields: [agentId], references: [id])
  itemType     String         // PROD_APPROVAL | RETIRE_APPROVAL | MAJOR_CHANGE
  packageMeta  String         // 심의 패키지 스냅샷 (JSON)
  decision     String?        // CouncilDecision: APPROVED|CONDITIONAL|REMANDED|REJECTED|DEFERRED
  decisionNote String?
  conditions   String?        // JSON: [{condition, done, checkedBy}]
  decidedAt    DateTime?
}

// ─── v3: 데이터 플랫폼 모델 ──────────────────────────────────────────

model DataAsset {
  id             String    @id @default(cuid())
  name           String
  description    String
  ownerDept      String
  classification String    // DataClassification: G1|G2|G3
  schemaMeta     String?
  deliveryModes  String    // "API,FILE,DB"
  updateCycle    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  requests       DataRequest[]
}

model DataRequest {
  id             String    @id @default(cuid())
  type           String    // DataRequestType: ACCESS|NEW
  status         String    @default("REQUESTED") // DataRequestStatus
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  agentId        String?
  assetId        String?
  asset          DataAsset? @relation(fields: [assetId], references: [id])
  requesterId    String
  purpose        String
  requestedSpec  String?
  classification String    // DataClassification: G1|G2|G3
  periodMonths   Int
  forProduction  Boolean   @default(false)
  rejectReason   String?
  reviewerId     String?
  prevRequestId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  provision      DataProvision?
}

model DataProvision {
  id            String      @id @default(cuid())
  requestId     String      @unique
  request       DataRequest @relation(fields: [requestId], references: [id])
  deliveryMode  String      // API | FILE | DB
  connectionRef String      // 시크릿 저장소 키
  providedAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
}

// ── 이의제기 (P1-3: 신청자 재심 요청 절차) ─────────────────────────────────
model ProjectAppeal {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  requesterEmail  String                         // 신청자 이메일
  reason          String                         // 이의 사유
  evidenceNote    String    @default("")         // 근거 자료·보충 설명
  status          String    @default("PENDING")  // PENDING | UNDER_REVIEW | ACCEPTED | REJECTED
  reviewedBy      String?                        // AX팀 검토자 이메일
  reviewNote      String    @default("")         // AX팀 검토 의견
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ── 거버넌스 문서 메타데이터 (AX_전사AI운영체계_제안 §2) ─────────────────────
// docId 체계: AX-{TYPE}-{YYYY}-{NNN}
//   REG=규정 | OPS=운영방안 | GUI=지침 | GDL=가이드라인 | MAN=매뉴얼 | DEV=개발표준 | TEC=기술문서
model GovernanceDoc {
  id            String    @id @default(cuid())
  docId         String    @unique   // e.g. "AX-REG-2026-001"
  fileName      String    @unique   // docs/ 하위 파일명 e.g. "AX-GUIDELINE-2026-001_AI거버넌스기본지침.md"
  type          String    // 규정|운영방안|지침|가이드라인|매뉴얼|개발표준|기술문서
  level         String    @default("L2")  // L1|L2|L3|L4
  title         String
  version       String    @default("v1.0")
  author        String    @default("")
  approvedBy    String    @default("")
  approvedAt    DateTime?
  securityLevel String    @default("G2")  // G1|G2|G3
  status        String    @default("active")  // active|draft|deprecated
  description   String    @default("")
  relatedDocs   String    @default("[]")  // JSON: 관련 문서 docId 배열
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// v3.1 — 인앱 알림 (Telegram 대체 1단계)
model Notification {
  id             String    @id @default(cuid())
  recipientEmail String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientEmail, readAt])
}

// ─── PI 효과 실현 추적 (v3.2) ─────────────────────────────────────────────
model BenefitRecord {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  agentId       String?
  period        String   // "2026-Q3"
  realizedValue Float
  unit          String
  note          String   @default("")
  recordedBy    String
  createdAt     DateTime @default(now())

  @@unique([projectId, period])
}
