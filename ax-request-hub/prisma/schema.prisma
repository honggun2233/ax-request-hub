// ?�?�?� PI ?�과 ?�현 추적 (v3.2) ?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�
model BenefitRecord {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  agentId       String?
  period        String   // "2026-Q3"
  realizedValue Float
