// v3.1 추가 — schema.prisma에 병합 후 `npx prisma migrate dev --name v3_1_notification`
// 수신자 키는 이메일 — Project.requesterEmail, ProjectAppeal.requesterEmail 등 기존 관례와 통일

model Notification {
  id             String    @id @default(cuid())
  recipientEmail String
  title          String
  body           String
  link           String?   // 클릭 시 이동 경로 (예: /me/projects)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientEmail, readAt])
}
