# ── 데이터베이스 ─────────────────────────────────────────────
# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ax_hub"

# ── NextAuth ─────────────────────────────────────────────────
# 최소 32자 랜덤 문자열: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
NEXTAUTH_URL="https://ax-hub.samsungam.com"

# ── 서버 공개 URL ────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://ax-hub.samsungam.com"

# ── 이메일 (SMTP) ────────────────────────────────────────────
SMTP_HOST="smtp.samsungam.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ax-hub@samsungam.com"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
SMTP_FROM="AX Hub <ax-hub@samsungam.com>"

# ── 알림 설정 ────────────────────────────────────────────────
APPROVAL_THRESHOLD=70

# ── AI (선택) ─────────────────────────────────────────────────
# Claude API — 에이전트 품질 평가, 스코어링에 사용
# ANTHROPIC_API_KEY="sk-ant-..."
